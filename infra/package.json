    "deploy": "bash scripts/deploy.sh",
    "demo-user": "node --import tsx scripts/demo-user.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1156.0",
    "@aws-sdk/client-sfn": "3.1156.0",
    "@aws-sdk/client-sns": "3.1156.0",
    "@aws-sdk/lib-dynamodb": "3.1156.0",
    "@gridrisk/agent": "0.0.0",
    "@gridrisk/engine": "0.0.0",
    "@gridrisk/shared": "0.0.0",
    "aws-cdk-lib": "2.274.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1156.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@types/aws-lambda": "^8.10.145",
    "aws-cdk": "2.1146.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.0"
  }
