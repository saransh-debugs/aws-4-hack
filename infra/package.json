{
  "name": "@gridrisk/infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app (owner: Darsh). M0 = empty stack; nothing is deployed.",
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "typecheck": "tsc --noEmit -p tsconfig.json",
