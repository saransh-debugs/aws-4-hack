# Copy to .env (gitignored) and fill in. Values are published by Darsh (handoff H6).

# Web app
# mock = fully offline, in-memory fixtures. live = deployed API.
VITE_DATA_MODE=mock
# Amazon Location API key (referrer-restricted). Empty = bundled offline dark style.
VITE_LOCATION_API_KEY=
VITE_API_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Backend / agent
AWS_REGION=us-east-1
# e.g. a Claude model ID or inference profile enabled in your Bedrock account
BEDROCK_MODEL_ID=

# -----------------------------------------------------------------------------
# H6 — where the live values come from (populated by `cdk deploy`, owner: Darsh)
# -----------------------------------------------------------------------------
# The GridRiskStack publishes these to SSM Parameter Store. After a deploy, read
# them back and fill the VITE_* values above:
#
#   VITE_API_URL              <- /gridrisk/api-url
#   VITE_COGNITO_USER_POOL_ID <- /gridrisk/cognito-user-pool-id
#   VITE_COGNITO_CLIENT_ID    <- /gridrisk/cognito-client-id
#
# CloudFormation cannot return the raw Location key value, so only the key NAME is
# stored (/gridrisk/location-api-key-name). Resolve the actual key like this:
#
#   KEY_NAME=$(aws ssm get-parameter --name /gridrisk/location-api-key-name \
#     --query Parameter.Value --output text)
#   aws location describe-key --key-name "$KEY_NAME" --query Key --output text
#
# Pull them all at once:
#   aws ssm get-parameters-by-path --path /gridrisk --query 'Parameters[].[Name,Value]' --output text

