# Copy to .env (gitignored) and fill in. Values are published by Darsh (handoff H6).

# Web app
# mock = fully offline, in-memory fixtures. live = deployed API.
VITE_DATA_MODE=mock
# live mode without a backend: set VITE_DATA_MODE=live and VITE_API_MOCKING=msw (leave VITE_API_URL empty).
VITE_API_MOCKING=
# Amazon Location API key (referrer-restricted). Empty = bundled offline dark style.
VITE_LOCATION_API_KEY=
VITE_LOCATION_MAP_NAME=
VITE_AWS_REGION=us-east-1
# Deployed HTTP API base URL (from SSM /gridrisk/api-url). Empty = same-origin /api (MSW in dev).
VITE_API_URL=
# Cognito pool + app client for live-mode sign-in (USER_PASSWORD_AUTH).
# The web app reads these to build the InitiateAuth request; no aws-amplify dependency.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Backend / agent
AWS_REGION=us-east-1
# e.g. a Claude model ID or inference profile enabled in your Bedrock account
BEDROCK_MODEL_ID=

# Operational data feeds (approved provider endpoints; leave empty for fixture mode)
GRIDRISK_UTILITY_OUTAGES_URL=
GRIDRISK_CENTERPOINT_OUTAGES_URL=https://gis.centerpointenergy.com/arcgis/rest/services/Outage/OUTAGE_TRACKER_OEP_ALL/MapServer/0/query
GRIDRISK_TRANSTAR_LANE_CLOSURES_URL=https://traffic.houstontranstar.org/data/rss/laneclosures_rss.xml
GRIDRISK_SHELTERS_URL=
GRIDRISK_ALLOW_SYNTHETIC_UTILITY=false
GRIDRISK_SYNTHETIC_ZONE_ID=zone-a
GRIDRISK_DEMO_MODE=false
GRIDRISK_SNAPSHOTS_TABLE=
GRIDRISK_EVENTS_TABLE=
GRIDRISK_SNAPSHOT_MAX_AGE_MINUTES=60
GRIDRISK_BACKUP_MINUTES_MIN=60
GRIDRISK_BACKUP_MINUTES_MAX=180
GRIDRISK_RESPONSE_MINUTES_MIN=45
GRIDRISK_RESPONSE_MINUTES_MAX=120
GRIDRISK_BACKUP_MINUTES_NOMINAL=120
GRIDRISK_RESPONSE_MINUTES_NOMINAL=75

# -----------------------------------------------------------------------------
# H6 — where the live values come from (populated by `cdk deploy`, owner: Darsh)
# -----------------------------------------------------------------------------
# The GridRiskStack publishes these to SSM Parameter Store. After a deploy, read
# them back and fill the VITE_* values above:
#
#   VITE_API_URL              <- /gridrisk/api-url
#   VITE_COGNITO_USER_POOL_ID <- /gridrisk/cognito-user-pool-id
#   VITE_COGNITO_CLIENT_ID    <- /gridrisk/cognito-client-id
#
# CloudFormation cannot return the raw Location key value, so only the key NAME is
# stored (/gridrisk/location-api-key-name). Resolve the actual key like this:
#
#   KEY_NAME=$(aws ssm get-parameter --name /gridrisk/location-api-key-name \
#     --query Parameter.Value --output text)
#   aws location describe-key --key-name "$KEY_NAME" --query Key --output text
#
# Pull them all at once:
#   aws ssm get-parameters-by-path --path /gridrisk --query 'Parameters[].[Name,Value]' --output text

